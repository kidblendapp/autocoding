{
  "name": "autocoding",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "tsc && npm run copy:html",
    "copy:html": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','visualization','gantt-viewer.html');const dst=path.join('dist','visualization','gantt-viewer.html');if(fs.existsSync(src)){fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/ui-server/routes/__tests__/config.unit.test.ts",
    "test:integration": "vitest run src/ui-server/routes/__tests__/config.integration.test.ts src/ui-server/routes/__tests__/jira.integration.test.ts",
    "test:smoke": "vitest run tests/smoke/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:smoke",
    "start": "node dist/index.js",
    "gantt:generate": "node dist/index.js --generate-gantt",
    "gantt:view": "node dist/index.js --generate-gantt --open",
    "stop:servers": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-servers.ps1",
    "ui:server": "ts-node src/ui-server/server.ts",
    "ui:server:clean": "npm run stop:servers && npm run ui:server",
    "ui:dev": "npm run stop:servers && concurrently \"npm run ui:server\" \"cd ui && npm run dev\"",
    "ui:build": "cd ui && npm run build",
    "ui:start": "npm run ui:server:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidblendapp/autocoding.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kidblendapp/autocoding/issues"
  },
  "homepage": "https://github.com/kidblendapp/autocoding#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@xyflow/react": "^12.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "vis-timeline": "^7.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
